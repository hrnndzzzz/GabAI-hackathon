# Copy to .env and fill in. Placeholders only: never commit real values.
# Every name maps to a field in app/config.py.

# local | test | production. local creates SQLite tables at startup but still needs real Supabase Auth.
APP_ENV=local
DATABASE_URL=sqlite:///./teachease.db
# Production: postgresql+psycopg://teachease_login:<url-encoded-password>@<host>:5432/postgres?sslmode=require

# Supabase project → Settings → API. The publishable key is public by design; no service-role key is needed.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
REQUIRE_MFA=true

# Online OCR and teaching drafts. Without these only the AI endpoints are disabled (503 ai_not_configured).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# JSON list of allowed browser origins. The Android app's WebView is https://appassets.androidplatform.net;
# add http://localhost:5179 while running `npm run dev` in mobile/web.
CORS_ORIGINS=["https://appassets.androidplatform.net"]

# Optional limits (defaults shown)
# AI_REQUESTS_PER_MINUTE=10
# AI_TIMEOUT_SECONDS=45
# MAX_CONCURRENT_OCR=2
