# Copy to .env.local for `npm run dev`. Android builds read these from ../local.properties instead
# (gabai.apiBaseUrl, gabai.supabaseUrl, gabai.supabasePublishableKey).
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
